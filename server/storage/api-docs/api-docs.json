{
    "openapi": "3.0.0",
    "info": {
        "title": "Laravel API Documentation",
        "description": "Tài liệu RESTful API hệ thống",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api",
            "description": "Development API Server"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Đăng ký tài khoản",
                "operationId": "00dc93e0285b0acb9d5d58f262c889a5",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Đăng ký thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "type": "object"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "1|laravelsanctumtokenstring..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Đăng nhập hệ thống",
                "operationId": "52ed350c039ca2cc95d9a3e9ff1f9bcf",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "type": "object"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "2|laravelsanctumtokenstring..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Email hoặc mật khẩu sai"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Đăng xuất tài khoản",
                "operationId": "d379d787ab3e65130a4db4f47e7c5f74",
                "responses": {
                    "200": {
                        "description": "Đăng xuất thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Đăng xuất thành công"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/user": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Lấy thông tin người dùng đang đăng nhập",
                "operationId": "d06f0e40ce0afff62a18438ee738d01d",
                "responses": {
                    "200": {
                        "description": "Thông tin profile user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "Nguyen Van A"
                                        },
                                        "email": {
                                            "type": "string",
                                            "example": "user@example.com"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated (Chưa đăng nhập)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks": {
            "get": {
                "tags": [
                    "Task"
                ],
                "summary": "Danh sách công việc của người dùng",
                "operationId": "b64fe300c51e709c7df9670e9ba12c6d",
                "responses": {
                    "200": {
                        "description": "Lấy danh sách công việc thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/TaskItem"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Task"
                ],
                "summary": "Tạo mới công việc",
                "operationId": "672f9510f19a18d4abfda4fc24526b5a",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Hoàn thiện dashboard"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Tạo giao diện task và hoàn thiện CRUD"
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "TODO",
                                        "enum": [
                                            "TODO",
                                            "IN_PROGRESS",
                                            "DONE"
                                        ]
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "HIGH",
                                        "enum": [
                                            "LOW",
                                            "MEDIUM",
                                            "HIGH"
                                        ]
                                    },
                                    "due_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-10-10"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Tạo công việc thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Tạo công việc thành công"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/TaskItem"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks/{id}": {
            "get": {
                "tags": [
                    "Task"
                ],
                "summary": "Lấy chi tiết công việc theo ID",
                "operationId": "43b80e8af6c37b43b1301b4ae030306a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID công việc",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Thông tin công việc",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TaskItem"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Không có quyền truy cập"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Task"
                ],
                "summary": "Cập nhật công việc",
                "operationId": "da8635c77516300db0c605049349b1be",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID công việc",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Hoàn thiện dashboard"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Cập nhật giao diện và validation",
                                        "nullable": true
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "IN_PROGRESS",
                                        "enum": [
                                            "TODO",
                                            "IN_PROGRESS",
                                            "DONE"
                                        ]
                                    },
                                    "priority": {
                                        "type": "string",
                                        "example": "MEDIUM",
                                        "enum": [
                                            "LOW",
                                            "MEDIUM",
                                            "HIGH"
                                        ]
                                    },
                                    "due_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-10-12"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cập nhật công việc thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Cập nhật công việc thành công"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/TaskItem"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Dữ liệu không hợp lệ"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Không có quyền truy cập"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Task"
                ],
                "summary": "Xóa công việc",
                "operationId": "79ef71e8c463c2cc3a700bad7e6e0f20",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID công việc cần xoá",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Xóa công việc thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Xóa công việc thành công"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Không có quyền truy cập"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/health-check": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Kiểm tra trạng thái server",
                "operationId": "66fec15b64b82a6577bfad396fcd4aca",
                "responses": {
                    "200": {
                        "description": "Server hoạt động bình thường",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "TaskItem": {
                "title": "Task Item",
                "required": [
                    "id",
                    "title",
                    "status",
                    "priority"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Hoàn thiện dashboard"
                    },
                    "description": {
                        "type": "string",
                        "example": "Tạo giao diện task và hoàn thiện CRUD",
                        "nullable": true
                    },
                    "status": {
                        "type": "string",
                        "example": "TODO",
                        "enum": [
                            "TODO",
                            "IN_PROGRESS",
                            "DONE"
                        ]
                    },
                    "priority": {
                        "type": "string",
                        "example": "HIGH",
                        "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH"
                        ]
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-10-10",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-29 10:00:00"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-09-29 10:05:00"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "title": "Login Request",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "Secret123@"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "title": "Register Request",
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Nguyen Van A"
                    },
                    "email": {
                        "type": "string",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "Secret123@"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "example": "Secret123@"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Quản lý xác thực người dùng"
        },
        {
            "name": "Task",
            "description": "Quản lý công việc của người dùng"
        },
        {
            "name": "System",
            "description": "System"
        }
    ]
}