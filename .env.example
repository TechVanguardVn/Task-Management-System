# ===========================================================================
# Task Management System - Environment Variables Template
#
# Instructions:
# 1. Copy this template to ".env":
#    cp .env.example .env
# 2. Fill in secure values for local development or production.
# 3. NEVER commit your actual ".env" file to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application Environment
# Allowed values: development | test | production
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# Microsoft SQL Server 2022 Database Configuration
# ---------------------------------------------------------------------------
# System Administrator (SA) password for SQL Server.
# Must meet SQL Server password complexity requirements:
# - At least 8 characters long
# - Contains uppercase, lowercase, numbers, and special symbols
MSSQL_SA_PASSWORD=YourStrong_Password123!

# Target database name
MSSQL_DB_NAME=task_management_db

# Host port mapping for SQL Server (default: 1433)
MSSQL_PORT=1433

# ---------------------------------------------------------------------------
# Database Connection URL (SQLAlchemy + pyodbc format)
#
# A. Docker Compose environment (uses service DNS "db"):
#    DATABASE_URL=mssql+pyodbc://sa:${MSSQL_SA_PASSWORD}@db:1433/task_management_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# B. Local host development (connecting to SQL Server on localhost:1433):
#    DATABASE_URL=mssql+pyodbc://sa:YourStrong_Password123%21@localhost:1433/task_management_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# Notes:
# - Special characters in passwords (e.g. '@' -> '%40', '!' -> '%21') must be URL-encoded for pyodbc.
# - TrustServerCertificate=yes is for development/test only. In production, use trusted certificates.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Database Seeder Flag (Docker Compose startup)
# Set to true to automatically seed demo account and tasks on container startup.
# ---------------------------------------------------------------------------
SEED_DATABASE=true

# ---------------------------------------------------------------------------
# JWT Authentication
#
# Generate a strong 64-character secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production, JWT_SECRET must be at least 32 characters.
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-secret-key-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# CORS Allowed Origins
# Comma-separated list of allowed web origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Service Port Mappings (Host Ports)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
