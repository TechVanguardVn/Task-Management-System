# =============================================================================
# Biến môi trường của Task Management System
#
# Cách dùng:
#   1. Copy file này thành ".env" (cùng thư mục):   cp .env.example .env
#   2. Điền giá trị thật vào ".env". File ".env" đã nằm trong .gitignore, KHÔNG commit.
#
# Spring Boot tự đọc file .env khi chạy từ thư mục task-management (xem spring.config.import
# trong application.yml). Biến môi trường của hệ điều hành / Docker sẽ ghi đè giá trị trong .env.
#
# Lưu ý format: KEY=value, không để dấu ngoặc kép, không có khoảng trắng quanh dấu "=".
# =============================================================================

# ----- JWT (BẮT BUỘC) -----
# Chuỗi Base64, tối thiểu 32 byte (256 bit) sau khi decode. Tạo ngẫu nhiên bằng 1 trong các lệnh:
#   openssl rand -base64 64
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# Thời gian sống của token (mili giây). Mặc định 86400000 = 24 giờ
JWT_EXPIRATION=86400000

# ----- Server (không bắt buộc) -----
# Khi deploy lên Render/Railway...: nền tảng tự cấp biến PORT, app ưu tiên PORT hơn SERVER_PORT
SERVER_PORT=8080

# ----- Database khi chạy local bằng ./mvnw spring-boot:run (không bắt buộc) -----
# Không khai báo thì dùng H2 in-memory, chế độ tương thích MySQL (dữ liệu mất khi tắt app).
# Muốn dùng MySQL của Docker Compose cho app chạy local: chạy "docker compose up -d mysql" rồi đổi thành:
#   DB_URL=jdbc:mysql://localhost:3306/taskdb?useSSL=false&allowPublicKeyRetrieval=true
#   DB_USERNAME=taskuser
#   DB_PASSWORD=<giá trị MYSQL_PASSWORD bên dưới>
# Database trên cloud tương thích MySQL, vd TiDB Cloud Starter (bắt buộc SSL, port 4000):
#   DB_URL=jdbc:mysql://<host>:4000/taskdb?sslMode=VERIFY_IDENTITY&createDatabaseIfNotExist=true&characterEncoding=UTF-8
#   DB_USERNAME=<tiền tố>.root
#   DB_PASSWORD=<password tạo trong TiDB Cloud>
DB_URL=jdbc:h2:mem:taskdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=

# ----- MySQL cho Docker Compose (BẮT BUỘC khi chạy docker compose up) -----
# App trong Docker tự kết nối tới MySQL bằng các giá trị này (không dùng DB_URL ở trên).
# Đây cũng là thông tin để đăng nhập bằng MySQL Workbench: host localhost, port MYSQL_PORT.
MYSQL_DATABASE=taskdb
MYSQL_USER=taskuser
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_PORT=3306

# ----- AI: thêm task bằng câu nói tự nhiên (không bắt buộc) -----
# Để trống AI_API_KEY → tắt tính năng AI, mọi chức năng khác vẫn chạy bình thường.
# Lấy key MIỄN PHÍ: https://aistudio.google.com → đăng nhập Google → "Get API key".
# Lưu ý gói miễn phí: Google có thể dùng nội dung gửi lên để cải thiện sản phẩm → không nhập thông tin nhạy cảm.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# Số lần gọi AI tối đa của 1 user trong 1 giờ (bảo vệ hạn mức miễn phí)
AI_MAX_REQUESTS_PER_HOUR=20
# Tổng số lần gọi AI của CẢ APP trong 24 giờ (0 = không giới hạn). Nên đặt khi deploy công khai,
# vì ai cũng đăng ký được nhiều tài khoản
AI_MAX_REQUESTS_PER_DAY=200

# Múi giờ cho container (ảnh hưởng tới CURRENT_DATE của MySQL và LocalDate.now() của app)
TZ=Asia/Ho_Chi_Minh
