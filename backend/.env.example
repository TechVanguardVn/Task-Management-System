# Application
NODE_ENV=development
PORT=3000

# PostgreSQL — replace placeholders with your Supabase session pooler credentials.
# Run backend and Prisma commands from the backend directory.
# Percent-encode special characters in the database password.
# Download the CA certificate from Supabase Database Settings and store it outside the repo.
# Replace CERTIFICATE_PATH with its absolute path (percent-encoded for a URL).
DATABASE_URL="postgresql://prisma.PROJECT_REF:DATABASE_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=CERTIFICATE_PATH"
