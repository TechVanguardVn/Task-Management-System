# ---------- Server ----------
NODE_ENV=development
PORT=4000
# Origin của frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173

# ---------- Database ----------
# Docker Compose / Postgres cài sẵn / `npm run db:local` đều dùng chuỗi này
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public
# Database riêng cho integration test (bị xoá dữ liệu mỗi lần chạy test)
TEST_DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public

# ---------- Auth ----------
# Đổi thành chuỗi ngẫu nhiên >= 32 ký tự, ví dụ:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Thời gian sống của phiên đăng nhập (giờ)
SESSION_TTL_HOURS=24
# Cost factor của bcrypt (10-14)
BCRYPT_ROUNDS=12
